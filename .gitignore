# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Vite / cache
.vite/
.cache/

# Coverage
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment
.env
.env.*
!.env.example

# Temp
tmp/
temp/

# Asset-prep raw inputs (PixelLab north-facing originals; prepped into assets/*.png)
assets/_raw/

# OMC harness session state — 하위 디렉터리에서 세션이 시작되면 그 경로에도 .omc/state/ 가
# 생기므로 루트만이 아니라 어느 깊이든 잡는다(assets/.omc/state/ 등이 실제로 생겼다).
**/.omc/state/

# OMC 세션 종료 기록 — 세션마다 UUID 파일이 하나씩 쌓이는 머신 로컬 상태다(.omc/state/ 와 같은 성격).
# 리포에 들어갈 물건이 아니고, 커밋하면 세션 수만큼 무한히 늘어난다.
.omc/sessions/

# OMC 프로젝트 스캔 캐시 — 워크트리 절대경로·세션 임시파일 경로·접근 카운터가 담긴
# 머신 로컬 상태다(.omc/state/ 와 같은 성격). 커밋하면 세션마다 churn 이 난다.
.omc/project-memory.json

# Edge Function 자립 번들 산출물(deno task bundle) — 소스 index.ts가 원본, 커밋 금지
supabase/functions/**/dist.index.js

# Supabase CLI 로컬 상태(연결된 프로젝트 정보·CLI 버전) — 머신마다 다르고 리포에 들어갈 물건이 아니다
supabase/.temp/

# env-verify 캡처 스크린샷(장당 ~2.8MB). 수치는 BASELINE.md 에 남고 이미지는 세션 내 대조용이라
# 커밋하지 않는다. **디렉터리를 하나만 적으면 안 된다** — `env-shots-after`/`env-baseline` 처럼
# 비교 대상 디렉터리가 늘어나는데, 좁게 적었다가 실제로 16장(약 40MB)이 커밋된 적이 있다.
.omc/research/env-shots*/**/*.png
.omc/research/env-shots*/*.png
.omc/research/env-baseline/*.png
# 엔티티 AAA 레인(플레이어·적·해저드)의 before/after 컷. 같은 이유로 커밋하지 않는다 —
# 여기는 `bg` 가 아니라 엔티티가 보이는 컷이라 장당 ~2MB 다.
.omc/research/entity-aaa-shots/**/*.png

# 3D 모델 원본(수십 MB) — Meshy 에 남아 있고 manifest.json 의 task id 로 다시 받는다.
assets/models/_source/
