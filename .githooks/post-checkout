#!/bin/sh
# post-checkout 훅 — 새 git worktree(빈 node_modules)에 pnpm 의존성을 자동 설치한다.
#
# 왜: git worktree 는 .git 이력만 공유하고 node_modules 는 워크트리마다 별도라, 새 워크트리를
# 만들면 node_modules 가 비어 있어 손으로 `pnpm install` 을 돌려야 했다. 이 훅이 그 한 번을
# 대신한다. pnpm 은 전역 스토어에서 하드링크로 깔아 이 설치가 수 초로 끝난다.
#
# 언제: git 은 `git checkout <branch>` 와 `git worktree add` 뒤 이 훅을 부른다. 인자는
#   $1 = 이전 HEAD ref · $2 = 새 HEAD ref · $3 = 플래그(1=브랜치 체크아웃, 0=파일 체크아웃).
# 파일 체크아웃(`git checkout -- path`)에는 반응하지 않는다($3=1 일 때만).
#
# 활성화(클론/머신당 최초 1회 — 공용 git 설정이라 모든 워크트리에 적용):
#   git config core.hooksPath .githooks
#
# 안전: 실패해도 체크아웃을 막지 않는다(항상 exit 0). 이미 node_modules 가 있으면 즉시 스킵해
# 브랜치 전환마다 도는 것을 막는다.

# 브랜치 체크아웃(worktree add 포함)일 때만.
[ "$3" = "1" ] || exit 0

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -n "$root" ] || exit 0

# .env.local 을 주 워크트리에서 복사한다(없을 때만).
#
# 왜: Supabase 설정은 gitignore 대상이라 새 워크트리에 안 따라온다. 그러면 readSupabaseConfig()
# 가 null 이 되어 **게임 전체가 오프라인으로 떨어진다** — 의뢰서·코어 모듈·침공·방어 화면이
# 전부 빈 채로 잠기고, 하네스로 띄워도 원인을 알기 어렵다(로그인 게이트조차 안 뜬다).
#
# 주 워크트리(= git common dir 의 부모)를 원본으로 삼는다. 이미 있으면 절대 덮지 않는다 —
# 워크트리마다 다른 프로젝트를 가리키게 두는 경우가 있다.
git_common=$(git rev-parse --git-common-dir 2>/dev/null)
if [ -n "$git_common" ] && [ ! -f "$root/.env.local" ]; then
  # --git-common-dir 는 주 워크트리의 .git 을 가리킨다(상대 경로일 수 있어 -- 로 정규화).
  main_root=$(cd "$git_common/.." 2>/dev/null && pwd)
  if [ -n "$main_root" ] && [ "$main_root" != "$root" ] && [ -f "$main_root/.env.local" ]; then
    cp "$main_root/.env.local" "$root/.env.local" &&
      echo "[post-checkout] .env.local 복사 완료 (원본: $main_root)"
  fi
fi

# 이미 설치돼 있으면 아무것도 안 한다(브랜치 전환 시 매번 도는 것 방지). 새 워크트리는
# node_modules 가 아예 없으므로 이 가드를 통과해 설치가 돈다.
[ -d "$root/node_modules" ] && exit 0

echo "[post-checkout] node_modules 없음 → pnpm 의존성 설치 (전역 스토어 재사용)…"
cd "$root" || exit 0

if command -v pnpm >/dev/null 2>&1; then
  pnpm install || echo "[post-checkout] pnpm install 실패 — 수동으로 'pnpm install' 실행하세요"
elif command -v corepack >/dev/null 2>&1; then
  # corepack enable 을 안 한 환경: shim 없이도 corepack 이 packageManager 핀 버전으로 실행한다.
  corepack pnpm install || echo "[post-checkout] corepack pnpm install 실패 — 수동 실행 필요"
else
  echo "[post-checkout] pnpm/corepack 을 찾지 못함 — Node(corepack 번들) 확인 후 'corepack pnpm install' 실행"
fi

exit 0
